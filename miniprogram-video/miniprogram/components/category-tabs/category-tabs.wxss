/* 分类标签栏组件样式 */
.tabs-scroll {
  width: 100%;
  background-color: #ffffff;
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  padding: 12rpx 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  white-space: nowrap;
  transition: all 0.2s;
}

.tab-item:last-child {
  margin-right: 0;
}

.tab-item-active {
  color: #ffffff;
  background: linear-gradient(135deg, #e94560, #c23152);
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(233, 69, 96, 0.25);
}

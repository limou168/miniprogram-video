/* 注册页样式 - 与登录页一致 */
.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 60rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.form-section {
  width: 100%;
}

.input-group {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 30rpx;
  height: 88rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

.input-group:focus-within {
  border-color: #e94560;
}

.input-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  color: #ffffff;
  font-size: 28rpx;
}

.placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.register-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.3);
}

.register-btn:active {
  opacity: 0.85;
}

.register-btn[disabled] {
  opacity: 0.6;
}

.footer-links {
  margin-top: 40rpx;
}

.link-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.link-text:active {
  color: #e94560;
}

/* 播放页样式 */
.play-container {
  width: 100%;
  min-height: 100vh;
  background-color: #000000;
  position: relative;
}

.video-wrapper {
  width: 100%;
  background-color: #000000;
}

.video-player {
  width: 100%;
}

/* 加载中 */
.loading-wrapper {
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #000000;
  color: #999;
  font-size: 28rpx;
}

/* 视频信息 */
.video-info {
  padding: 24rpx;
  background-color: #1a1a2e;
}

.play-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

.play-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.play-count {
  font-size: 24rpx;
  color: #999;
}

.control-btns {
  display: flex;
  gap: 16rpx;
}

.ctrl-btn {
  padding: 8rpx 20rpx;
  background-color: rgba(233, 69, 96, 0.2);
  border-radius: 20rpx;
  border: 1rpx solid rgba(233, 69, 96, 0.4);
}

.ctrl-btn text {
  font-size: 22rpx;
  color: #e94560;
}

/* 底部弹出面板 */
.panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.panel-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #1a1a2e;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 60vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #333;
}

.panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.panel-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.panel-list {
  padding: 16rpx 32rpx;
  max-height: 400rpx;
}

.panel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  color: #ccc;
  border-bottom: 1rpx solid #2a2a3e;
}

.panel-item-active {
  color: #e94560;
}

.panel-item:active {
  background-color: #2a2a3e;
}

.panel-check {
  color: #e94560;
  font-size: 28rpx;
}

/* 倍速网格 */
.speed-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 32rpx;
  gap: 16rpx;
}

.speed-item {
  width: calc(33.33% - 12rpx);
  padding: 24rpx 0;
  text-align: center;
  background-color: #2a2a3e;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #ccc;
}

.speed-item-active {
  background-color: #e94560;
  color: #ffffff;
}

.speed-item:active {
  opacity: 0.8;
}

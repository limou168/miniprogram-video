/* 主页样式 */
.index-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 轮播图 */
.banner-section {
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

/* 分类区域 */
.category-section {
  margin-bottom: 8rpx;
}

/* 导航标签（热门/最新/高分） */
.nav-tabs {
  display: flex;
  padding: 16rpx 24rpx 8rpx;
  gap: 16rpx;
}

.nav-item {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #ffffff;
  border-radius: 28rpx;
  border: 2rpx solid #eee;
}

.nav-item-active {
  color: #e94560;
  background-color: rgba(233, 69, 96, 0.06);
  border-color: #e94560;
}

/* 影视列表 */
.video-list {
  padding: 8rpx 24rpx;
}

.video-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

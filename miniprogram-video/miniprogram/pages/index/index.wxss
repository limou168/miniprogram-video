/* 主页样式 */
.index-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 轮播图 */
.banner-section {
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

/* ===== 主分类标签栏 ===== */
.category-section {
  background-color: #ffffff;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx 0;
}

.tabs-container {
  display: inline-flex;
  gap: 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  background-color: #f5f5f5;
}

.tab-item-active {
  color: #ffffff;
  background-color: #e94560;
}

/* ===== 子分类网格（3列） ===== */
.subcategory-section {
  background-color: #ffffff;
  padding: 12rpx 24rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sub-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sub-item {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #888;
  background-color: #fafafa;
  border-radius: 20rpx;
  border: 1rpx solid #eee;
  line-height: 1.6;
}

.sub-item-active {
  color: #e94560;
  background-color: rgba(233, 69, 96, 0.06);
  border-color: #e94560;
}

/* ===== 影视列表 ===== */
.video-list {
  padding: 8rpx 24rpx;
}

.video-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

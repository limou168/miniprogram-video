.category-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs-wrapper {
  background-color: #ffffff;
  padding-bottom: 8rpx;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx 8rpx;
}

.tabs-container {
  display: inline-flex;
  gap: 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  background-color: #f5f5f5;
}

.tab-item-active {
  color: #ffffff;
  background-color: #e94560;
}

.tab-arrow {
  font-size: 18rpx;
  margin-left: 6rpx;
}

.active-tag-bar {
  padding: 4rpx 24rpx 12rpx;
}

.active-tag-label {
  display: inline-block;
  font-size: 22rpx;
  color: #e94560;
  background-color: rgba(233, 69, 96, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 排序栏 */
.order-bar {
  display: flex;
  padding: 12rpx 24rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.order-item {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 20rpx;
  background-color: #f5f5f5;
}

.order-item-active {
  color: #e94560;
  background-color: rgba(233, 69, 96, 0.08);
}

/* 视频列表 */
.video-list {
  padding: 12rpx 24rpx;
}

.video-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 二级分类弹出面板 */
.panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.panel-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.panel-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.panel-body {
  flex: 1;
  padding: 20rpx 32rpx;
  max-height: 400rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
}

.tag-item-active {
  color: #e94560;
  background-color: rgba(233, 69, 96, 0.06);
  border-color: #e94560;
}

.panel-footer {
  padding: 20rpx 32rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  border: none;
}

.confirm-btn:active {
  opacity: 0.9;
}

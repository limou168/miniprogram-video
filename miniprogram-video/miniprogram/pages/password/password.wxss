/* 修改密码页样式 */
.password-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.form-section {
  background-color: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx;
}

.form-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.input-group {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-group:last-child {
  border-bottom: none;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input-placeholder {
  color: #ccc;
}

.btn-section {
  padding: 40rpx 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

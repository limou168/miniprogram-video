<!-- 修改密码页 -->
<view class="password-container">
  <view class="form-section">
    <view class="form-tip">为保障账号安全，请设置6-20位新密码</view>

    <view class="input-group">
      <text class="input-label">旧密码</text>
      <input
        class="input-field"
        type="password"
        placeholder="请输入旧密码"
        placeholder-class="input-placeholder"
        value="{{oldPassword}}"
        bindinput="onOldPwdInput"
      />
    </view>

    <view class="input-group">
      <text class="input-label">新密码</text>
      <input
        class="input-field"
        type="password"
        placeholder="请输入新密码（6-20位）"
        placeholder-class="input-placeholder"
        value="{{newPassword}}"
        bindinput="onNewPwdInput"
      />
    </view>

    <view class="input-group">
      <text class="input-label">确认密码</text>
      <input
        class="input-field"
        type="password"
        placeholder="请再次输入新密码"
        placeholder-class="input-placeholder"
        value="{{confirmPassword}}"
        bindinput="onConfirmPwdInput"
      />
    </view>
  </view>

  <view class="btn-section">
    <button class="submit-btn" bindtap="onSubmit" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '提交中...' : '确认修改'}}
    </button>
  </view>
</view>

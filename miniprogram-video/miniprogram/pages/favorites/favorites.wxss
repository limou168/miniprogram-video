/* 我的收藏页 */
.favorites-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 收藏列表 */
.fav-list {
  padding: 16rpx 24rpx;
}

.fav-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.fav-content {
  display: flex;
  padding: 20rpx;
  position: relative;
}

.fav-cover {
  width: 180rpx;
  height: 240rpx;
  border-radius: 10rpx;
  background-color: #e0e0e0;
  flex-shrink: 0;
}

.fav-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
  padding-right: 40rpx;
}

.fav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.fav-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  color: #e94560;
  background-color: rgba(233, 69, 96, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #999;
  margin-right: 12rpx;
}

.meta-score {
  font-size: 24rpx;
  color: #e94560;
  font-weight: bold;
}

.fav-time {
  font-size: 22rpx;
  color: #bbb;
}

.fav-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 28rpx;
}

.fav-remove:active {
  color: #e94560;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #999;
}

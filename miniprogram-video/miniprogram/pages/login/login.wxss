/* 登录页样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 表单区域 */
.form-section {
  width: 100%;
}

.input-group {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 0 30rpx;
  height: 96rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  transition: border-color 0.3s;
}

.input-group:focus-within {
  border-color: #e94560;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  color: #ffffff;
  font-size: 30rpx;
}

.placeholder {
  color: rgba(255, 255, 255, 0.4);
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.3);
}

.login-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.login-btn[disabled] {
  opacity: 0.6;
}

/* 底部链接 */
.footer-links {
  margin-top: 50rpx;
}

.link-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.link-text:active {
  color: #e94560;
}
